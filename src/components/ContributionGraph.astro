---
interface Contribution {
  date: string;
  count: number;
  level: number;
}

let contributions: Contribution[] = [];
let total = 0;

try {
  const response = await fetch(
    "https://github-contributions-api.jogruber.de/v4/iceSheep2003?y=last",
  );
  if (response.ok) {
    const data = await response.json();
    contributions = data.contributions ?? [];
    total = data.total?.lastYear ?? 0;
  }
} catch {
  // Keep the page buildable if the public contribution endpoint is unavailable.
}
---

<section class="contribution-card" aria-labelledby="contribution-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">公开活动</p>
      <h2 id="contribution-title">一年里的持续构建</h2>
    </div>
    <a href="https://github.com/iceSheep2003" target="_blank" rel="noreferrer">
      {total} 次公开贡献
    </a>
  </div>

  {
    contributions.length > 0 ? (
      <div class="graph-scroll" aria-label={`最近一年 ${total} 次公开贡献`}>
        <div class="graph" aria-hidden="true">
          {contributions.map((day) => (
            <span
              class={`cell level-${Math.min(day.level, 4)}`}
              title={`${day.date}: ${day.count} 次贡献`}
            />
          ))}
        </div>
      </div>
    ) : (
      <p class="empty">贡献数据暂时无法加载，可前往 GitHub 查看。</p>
    )
  }
</section>

<style>
  .contribution-card {
    @apply rounded-3xl bg-[var(--card-color)] p-6 md:p-8;
  }

  .section-heading {
    @apply mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between;
  }

  .eyebrow {
    @apply mb-1 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary-color)];
  }

  h2 {
    @apply text-2xl font-semibold text-[var(--text-color)] md:text-3xl;
  }

  a {
    @apply text-sm font-medium text-[var(--text-color-lighten)] transition-colors hover:text-[var(--primary-color)];
  }

  .graph-scroll {
    @apply overflow-x-auto pb-2;
  }

  .graph {
    display: grid;
    grid-template-rows: repeat(7, 12px);
    grid-auto-flow: column;
    grid-auto-columns: 12px;
    gap: 4px;
    width: max-content;
    min-width: 100%;
  }

  .cell {
    @apply rounded-[3px];
    background: var(--primary-color-lighten);
  }

  .level-1 {
    opacity: 0.42;
    background: var(--primary-color);
  }
  .level-2 {
    opacity: 0.62;
    background: var(--primary-color);
  }
  .level-3 {
    opacity: 0.8;
    background: var(--primary-color);
  }
  .level-4 {
    opacity: 1;
    background: var(--primary-color);
  }

  .empty {
    @apply text-sm text-[var(--text-color-lighten)];
  }
</style>
