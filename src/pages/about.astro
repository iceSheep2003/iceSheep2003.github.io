---
import { Icon } from "astro-icon/components";
import ContributionGraph from "../components/ContributionGraph.astro";
import { profile } from "../data/profile";
import Main from "../layouts/MainLayout.astro";
---

<Main hideSidebar={true}>
  <div class="profile-page">
    <section class="hero-card">
      <div class="avatar-stage">
        <span class="avatar-orbit" aria-hidden="true"></span>
        <img src="/avatar.jpg" alt="ice.Sheep 的头像" class="avatar" />
      </div>
      <div class="hero-copy">
        <p class="eyebrow">个人档案</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role} · 软件工程</p>
        <p class="intro">{profile.intro}</p>
        <div class="actions resume-actions">
          <a
            href={profile.github}
            target="_blank"
            rel="noreferrer"
            class="primary-action"
          >
            <Icon name="line-md:github-loop" size={20} />
            GitHub
          </a>
          <button
            type="button"
            onclick="window.print()"
            class="secondary-action"
          >
            <Icon name="mingcute:print-line" size={20} />
            打印 / 保存为 PDF
          </button>
        </div>
      </div>
    </section>

    <div class="resume-grid">
      <section class="card education-card">
        <p class="eyebrow">教育经历</p>
        <h2>软件工程</h2>
        <div class="timeline">
          {
            profile.education.map((item) => (
              <article class="timeline-item">
                <div class="education-heading">
                  <h3>{item.school}</h3>
                  <time>{item.period}</time>
                </div>
                <p>
                  {item.degree} · {item.major}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="card skills-card">
        <p class="eyebrow">能力</p>
        <h2>常用技术</h2>
        <div class="skill-list">
          {profile.skills.map((skill) => <span>{skill}</span>)}
        </div>
        <p class="skills-note">
          更关注如何把技术用于真实项目，而不是用百分比描述熟练程度。
        </p>
      </section>
    </div>

    <section class="projects-section card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">作品</p>
          <h2>代表项目</h2>
        </div>
        <a href={profile.github} target="_blank" rel="noreferrer"
          >查看全部仓库</a
        >
      </div>
      <div class="project-grid">
        {
          profile.projects.map((project) => (
            <a
              href={project.href}
              target="_blank"
              rel="noreferrer"
              class="project-card"
            >
              <div class="project-title">
                <h3>{project.name}</h3>
                <Icon name="mingcute:arrow-right-up-line" size={20} />
              </div>
              <p>{project.description}</p>
              <span>{project.language}</span>
            </a>
          ))
        }
      </div>
    </section>

    <ContributionGraph />
  </div>
</Main>

<style>
  .profile-page {
    @apply space-y-5;
  }
  .profile-page > * {
    opacity: 0;
    animation: profile-reveal 520ms ease-out forwards;
  }
  .profile-page > :nth-child(2) {
    animation-delay: 90ms;
  }
  .profile-page > :nth-child(3) {
    animation-delay: 180ms;
  }
  .profile-page > :nth-child(4) {
    animation-delay: 270ms;
  }
  .hero-card,
  .card {
    @apply rounded-3xl bg-[var(--card-color)];
  }
  .hero-card {
    position: relative;
    overflow: hidden;
    @apply grid gap-7 p-6 sm:grid-cols-[160px_1fr] sm:items-center md:p-10;
  }
  .hero-card::after {
    content: "";
    position: absolute;
    width: 18rem;
    height: 18rem;
    right: -7rem;
    top: -9rem;
    border-radius: 999px;
    background: var(--primary-color);
    filter: blur(70px);
    opacity: 0.12;
    animation: ambient-drift 9s ease-in-out infinite alternate;
    pointer-events: none;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .avatar-stage {
    position: relative;
    width: fit-content;
    isolation: isolate;
  }
  .avatar-orbit {
    position: absolute;
    inset: -8px;
    z-index: -1;
    border-radius: 1.9rem;
    border: 2px dashed
      color-mix(in oklch, var(--primary-color) 45%, transparent);
    animation: orbit-turn 18s linear infinite;
  }
  .avatar {
    @apply aspect-square w-32 rounded-3xl object-cover shadow-sm sm:w-40;
    transition:
      transform 350ms ease,
      box-shadow 350ms ease;
    animation: avatar-breathe 5s ease-in-out infinite;
  }
  .avatar-stage:hover .avatar {
    transform: translateY(-4px) rotate(-1deg);
    box-shadow: 0 18px 40px
      color-mix(in oklch, var(--primary-color) 18%, transparent);
  }
  .eyebrow {
    @apply mb-2 text-sm font-medium uppercase tracking-[0.18em] text-[var(--primary-color)];
  }
  h1 {
    @apply text-4xl font-semibold tracking-tight text-[var(--text-color)] md:text-5xl;
  }
  h2 {
    @apply text-2xl font-semibold text-[var(--text-color)] md:text-3xl;
  }
  h3 {
    @apply text-lg font-semibold text-[var(--text-color)];
  }
  .role {
    @apply mt-2 text-lg text-[var(--text-color-lighten)];
  }
  .intro {
    @apply mt-4 max-w-2xl text-base leading-8 text-[var(--text-color)];
  }
  .actions {
    @apply mt-6 flex flex-wrap gap-3;
  }
  .actions a,
  .actions button {
    @apply inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium transition-all active:scale-95;
  }
  .primary-action {
    @apply bg-[var(--primary-color)] text-white hover:brightness-95;
  }
  .secondary-action {
    @apply bg-[var(--primary-color-lighten)] text-[var(--primary-color)] hover:brightness-95;
  }
  .resume-grid {
    @apply grid gap-5 lg:grid-cols-[1.25fr_0.75fr];
  }
  .card {
    @apply p-6 md:p-8;
  }
  .timeline {
    @apply mt-6 space-y-6 border-l-2 border-[var(--primary-color-lighten)] pl-6;
  }
  .timeline-item {
    @apply relative;
  }
  .timeline-item::before {
    content: "";
    @apply absolute -left-[31px] top-1.5 h-3 w-3 rounded-full bg-[var(--primary-color)];
  }
  .timeline-item > p {
    @apply mt-1 text-[var(--text-color-lighten)];
  }
  .education-heading {
    @apply flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between;
  }
  .education-heading time {
    @apply text-sm font-medium tabular-nums text-[var(--primary-color)];
  }
  .skill-list {
    @apply mt-6 flex flex-wrap gap-2;
  }
  .skill-list span {
    @apply rounded-xl bg-[var(--primary-color-lighten)] px-3 py-2 text-sm font-medium text-[var(--primary-color)];
  }
  .skills-note {
    @apply mt-6 text-sm leading-6 text-[var(--text-color-lighten)];
  }
  .section-heading {
    @apply mb-6 flex items-end justify-between gap-4;
  }
  .section-heading > a {
    @apply text-sm font-medium text-[var(--text-color-lighten)] transition-colors hover:text-[var(--primary-color)];
  }
  .project-grid {
    @apply grid gap-4 md:grid-cols-2;
  }
  .project-card {
    @apply rounded-2xl border border-[var(--primary-color-transparent)] bg-[var(--background-color)] p-5 transition-all hover:-translate-y-1 hover:border-[var(--primary-color)];
    transition-duration: 280ms;
  }
  .project-title {
    @apply flex items-center justify-between gap-3 text-[var(--primary-color)];
  }
  .project-card > p {
    @apply my-3 leading-7 text-[var(--text-color-lighten)];
  }
  .project-card > span {
    @apply text-sm font-medium text-[var(--primary-color)];
  }

  @keyframes orbit-turn {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes avatar-breathe {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }
  @keyframes ambient-drift {
    from {
      transform: translate3d(0, 0, 0) scale(0.9);
    }
    to {
      transform: translate3d(-3rem, 2rem, 0) scale(1.12);
    }
  }
  @keyframes profile-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-card::after,
    .avatar-orbit,
    .avatar,
    .profile-page > * {
      animation: none;
      opacity: 1;
    }
  }

  @media print {
    :global(nav),
    :global(footer),
    .resume-actions,
    :global(.contribution-card) {
      display: none !important;
    }
    :global(body) {
      background: white !important;
    }
    .hero-card,
    .card {
      break-inside: avoid;
      box-shadow: none;
      border: 1px solid #ddd;
    }
    .profile-page > * {
      opacity: 1;
      animation: none;
    }
  }
</style>
